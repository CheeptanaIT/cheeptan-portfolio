# คัดลอกค่าจริงจาก InfinityFree vPanel และ Brevo มาตั้งเป็น environment
# variable บน hosting จริง (ไฟล์นี้เป็นแค่ตัวอย่าง ห้าม commit ค่าจริงลงไป)

# --- MySQL (InfinityFree > MySQL Databases) ---
DB_HOST=sql123.infinityfree.com
DB_NAME=if0_12345678_p1homeblog
DB_USER=if0_12345678
DB_PASS=your-database-password

# --- SMTP (Brevo > SMTP & API > SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=your-generated-smtp-key

# Brevo > Senders, Domains & Dedicated IPs > Senders — ต้อง verify อีเมลนี้ก่อน
# ไม่งั้น Brevo จะปฏิเสธการส่ง ถ้าไม่ตั้งค่านี้ ระบบจะ fallback ไปใช้ no-reply@โดเมนเว็บแทน (ซึ่งจะโดนปฏิเสธเช่นกัน)
SMTP_FROM_EMAIL=cheeptana.boy@gmail.com

# --- GitHub Actions secrets (ตั้งที่ repo Settings > Secrets and
# variables > Actions ไม่ใช่ในไฟล์นี้ — ใช้โดย .github/workflows/deploy.yml) ---
# FTP_SERVER      = FTP hostname จาก InfinityFree > FTP Accounts
# FTP_USERNAME    = FTP username จาก InfinityFree > FTP Accounts
# FTP_PASSWORD    = รหัสผ่าน FTP account ที่ตั้งไว้
# FTP_SERVER_DIR  = /htdocs/
